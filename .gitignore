# --- secrets: never commit ---
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
service-account*.json
ee-*.json
secrets.yaml
config.local.yaml

# --- generated data ---
# The detection store, run provenance, the site registry and the FIRMS raw
# responses are TRACKED (Task 08): a CI/cron run starts from a fresh
# checkout, and without them the published site IDs renumber, the three-
# year history is unrecoverable from NRT alone, and a failed fetch turns
# into a silent zero (AGENTS.md rule 2). Everything else under data/ is
# per-run output that a fresh run rewrites.
data/raw/*
!data/raw/*.csv
data/processed/*
!data/processed/detections.parquet
!data/processed/run_manifest.json
!data/processed/recurrent_sites.json
# Event registry (Task 16): event IDs survive re-runs only because the
# previous membership map is read back, so it has to travel with the repo.
# events.csv is the same records flattened and is regenerated from it.
!data/processed/events.json
# METAR corroboration (Task 19): the archive CSVs are the raw responses
# (AGENTS rule 2 - fetch once, parse forever after) and the JSON is
# deterministic from them, so both travel with the repo.
!data/raw/metar/
data/raw/metar/*
!data/raw/metar/*.csv
!data/processed/metar_corroboration.json
# Burned-area postmortem (Task 18): written by a by-hand Earth Engine run,
# so it travels with the repo rather than being regenerated on demand.
!data/processed/burned_areas.json
!data/processed/burned_areas.geojson
# Detection climatology evaluation (Task 17): the fold metrics the baseline
# is held to. Deterministic from the tracked store, but committed so later
# models can be compared against the same printed bar.
!data/processed/baseline_eval.json
# Onset brackets (Task 20): deterministic from the raw band-segments and
# the tracked events file, so the brackets any later reading relies on can
# be re-checked from the committed JSON.
!data/processed/himawari_onset.json
# Fire danger (Task 21): the per-month ERA5-Land raw responses are the
# fetch's persisted facts (AGENTS rule 2) and are small enough to track;
# the JSON is deterministic from them and the tracked store.
!data/raw/era5land/
data/raw/era5land/*
!data/raw/era5land/*.json
!data/processed/fire_danger.json
data/cache/
*.pmtiles
*.tif
*.tiff
*.nc
*.hdf

