# --- secrets: never commit ---
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
service-account*.json
ee-*.json
secrets.yaml
config.local.yaml

# --- generated data ---
# The detection store, run provenance, the site registry and the FIRMS raw
# responses are TRACKED (Task 08): a CI/cron run starts from a fresh
# checkout, and without them the published site IDs renumber, the three-
# year history is unrecoverable from NRT alone, and a failed fetch turns
# into a silent zero (AGENTS.md rule 2). Everything else under data/ is
# per-run output that a fresh run rewrites.
data/raw/*
!data/raw/*.csv
data/processed/*
!data/processed/detections.parquet
!data/processed/run_manifest.json
!data/processed/recurrent_sites.json
data/cache/
*.pmtiles
*.tif
*.tiff
*.nc
*.hdf

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# --- os / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# National BIG geodatabase (340 MB, manually downloaded, not redistributable here).
# Derive data/boundaries/ from it with scripts/extract_boundary.sh
*.gdb/
*.gdb.zip

# Himawari raw band-segments (~100 MB/day) and evening products - never
# commit; the producer is manual and closes on a different schedule (Task 08
# section 4).
data/raw/himawari/
data/processed/himawari_evening_*.parquet

# --- reference material, not ours to redistribute ---
# NASA ARSET training slides and the Mandum Rimba white paper are third-party
# documents kept locally for reference. Cite them; do not republish them.
ARSET_NASA/
mandum_rimba/
mandum_rimba-*.zip

# Boundaries for a different kabupaten, kept for unrelated work.
data/boundaries/yahukimo_desa.geojson
