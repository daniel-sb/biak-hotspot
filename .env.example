# Copy to .env and fill in. .env is gitignored — never commit real values.

# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# OpenAQ v3 API key: https://explore.openaq.org/register
# Only needed for the quarterly "has a station appeared in Papua yet" check (PLAN.md 9.5).
OPENAQ_KEY=

# Google Earth Engine service account. Store the JSON OUTSIDE the repo and point at it.
# This is the credential that actually costs money if leaked.
GEE_SERVICE_ACCOUNT_JSON=

# JAXA P-Tree FTP (Himawari, Phase 4). https://www.eorc.jaxa.jp/ptree/
PTREE_USER=
PTREE_PASS=

# Gamma Earth S2DR4/S2DR3 REST API (Task 24). Portal -> API Access & Keys.
# The key goes in the URL path, so never print a request URL that holds it.
GE_API_KEY=
